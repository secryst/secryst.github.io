---
import BaseLayout from '../layouts/BaseLayout.astro';
import TocNav from '../components/TocNav.astro';
import ModelsBrowser from '../components/vue/ModelsBrowser.vue';

// Sourced from the models.yaml index on interscript-ml main (2026-08-25).
const entries = [
  { id: 'ara-diac-1.0', task: 'diacritization', tier: 'teacher', reveals: 'Arabic consonants → harakāt', quality: '2.58% windowed DER-CE on SadeedDiac-25; 1.53% on word-final iʿrāb endings' },
  { id: 'ara-diac-small-1.0', task: 'diacritization', tier: 'student', reveals: 'Arabic → harakāt (compact, 1.3 GiB)', quality: '3.66% on the same harness — the +2.34pp cost of the ByT5-small client rung' },
  { id: 'heb-diac-1.1', task: 'diacritization', tier: 'student', reveals: 'Hebrew consonants → nikud', quality: '16.44% DER greedy / 16.43% beam-4 — the current best Hebrew rung' },
  { id: 'heb-diac-1.0', task: 'diacritization', tier: 'student', reveals: 'Hebrew → nikud', quality: '17.46% DER beam-4 (DictaBERT baseline 35.6%)' },
  { id: 'heb-diac-small-1.0', task: 'diacritization', tier: 'student', reveals: 'Hebrew → nikud (compact)', quality: '30.37% DER vs teacher 24.79% — +5.6pp for the 2× shrink' },
  { id: 'fas-g2p-1.0', task: 'g2p', tier: 'student', reveals: 'Persian → Latin reading', quality: '1.6% CER; 77.34% SentenceBench homograph accuracy' },
  { id: 'tha-g2p-base-1.0', task: 'g2p', tier: 'student', reveals: 'Thai → IPA', quality: 'teacher at 4.43% PER (public baseline 6.37%); student gated at +4.76pp' },
  { id: 'tha-g2p-small-1.0', task: 'g2p', tier: 'student', reveals: 'Thai → IPA (int8, 246 MiB)', quality: '2.85% PER greedy on the runtime protocol; parity 0.08pp' },
  { id: 'urd-diac-1.0', task: 'diacritization', tier: 'student', reveals: 'Urdu → vocalized text', quality: '3.74% CER' },
  { id: 'urd-g2p-1.0', task: 'g2p', tier: 'student', reveals: 'Urdu → phonemes (IPA)', quality: '14.77% CER — first learned Urdu baselines we know of' },
  { id: 'khm-latn-1.0', task: 'translit', tier: 'student', reveals: 'Khmer text → Latin reading', quality: '59.66% exact match, 27.42 CER (forward model)' },
] as const;
---

<BaseLayout
  title="Models"
  description="The secryst model zoo: ids resolvable through the models.yaml index, what each reveals, measured quality, and how conformance is enforced across crystals."
>
  <div class="docs-layout">
    <TocNav
      heading="Models"
      items={[
        { href: '#zoo', label: 'Model zoo' },
        { href: '#quality', label: 'Where the numbers come from' },
        { href: '#conformance', label: 'Conformance methodology' },
      ]}
    />

    <main class="page">
      <p class="page-eyebrow">Model zoo</p>
      <h1>Models you can scry with</h1>
      <p>Ids resolve through the <a href="https://github.com/interscript/interscript-ml/blob/main/models.yaml" rel="noreferrer">models.yaml index</a>. Teachers are the strongest trained models; students are the compact distillations that actually ship in the crystals.</p>

      <div class="sec" id="zoo">
        <h2>Zoo</h2>
        <ModelsBrowser entries={[...entries]} client:visible />
      </div>

      <div class="sec" id="quality">
        <h2>Where the numbers come from</h2>
        <p>Every metric above was produced by the benchmark&rsquo;s own evaluator on its full test set — Misraj&rsquo;s evaluator for SadeedDiac-25, SentenceBench for Persian homographs, the fixed 1,219-sentence Kaikki set for Thai — under published, zero-skip protocols. Methodology and run IDs live with each project&rsquo;s results file; nothing here is self-graded on a private split.</p>
      </div>

      <div class="sec" id="conformance">
        <h2>Conformance methodology</h2>
        <p>Teachers are trained in <a href="https://github.com/secryst/secryst-train" rel="noreferrer">secryst-train</a> (secryst&rsquo;s own monorepo); distilled students that pass the export gate are published into the <a href="https://github.com/interscript/interscript-ml" rel="noreferrer">interscript-ml</a> zoo. Before any model enters the index, the gate writes its parity record into the artifact: the student is diffed against its teacher on held-out samples, and a model whose behavior differs from its published identity does not ship. At the runtime level, the three crystals are diffed against each other on shared golden sets (generated by the Python crystal) in CI — the release gate for gem&nbsp;1.0 and every subsequent crystal release.</p>
      </div>
    </main>
  </div>
</BaseLayout>
